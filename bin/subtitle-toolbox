#!/usr/bin/env php
<?php

declare(strict_types=1);

use SubtitleToolbox\Cli\Application;

$autoloaders = [
    $GLOBALS["_composer_autoload_path"] ?? null,
    __DIR__ . "/../vendor/autoload.php",
    __DIR__ . "/../../../autoload.php",
];
foreach (array_filter($autoloaders) as $autoloader) {
    if (is_file($autoloader)) {
        require $autoloader;
        break;
    }
}

if (!class_exists(Application::class)) {
    fwrite(STDERR, "Cannot find the Composer autoloader. Run \"composer install\" first.\n");
    exit(2);
}

// OCR of a long file needs more than the 128 MB default. A Composer install leaves the limit to the user.
if (in_array("--ocr", $argv, true) && class_exists(Phar::class) && Phar::running() !== "" && ini_get("memory_limit") === "128M") {
    ini_set("memory_limit", "512M");
}

exit((new Application())->run($argv));
