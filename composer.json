{
  "name": "ymakhloufi/subtitle-toolbox",
  "description": "A toolbox for parsing, manipulating and exporting subtitles to various formats.",
  "keywords": [
    "subtitle",
    "srt",
    "vtt",
    "webvtt",
    "lrc",
    "mpsub",
    "parser",
    "converter"
  ],
  "homepage": "https://github.com/yama6a/subtitle-toolbox",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/yama6a/subtitle-toolbox/issues",
    "source": "https://github.com/yama6a/subtitle-toolbox"
  },
  "autoload": {
    "psr-4": {
      "SubtitleToolbox\\": "src/"
    }
  },
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit"
  }
}
